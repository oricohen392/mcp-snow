# Target ServiceNow Instance URL (Required)
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com

# Centralized Multi-User / OAuth 2.1 / OIDC Configuration
MCP_PUBLIC_URL=https://mcp-snow.example.com
OIDC_ISSUER_URL=https://login.microsoftonline.com/your-tenant-id/v2.0
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret
# OAUTH_AUTHORIZE_URL=https://your-instance.service-now.com/oauth_auth.do
# OAUTH_TOKEN_URL=https://your-instance.service-now.com/oauth_token.do
# OAUTH_SCOPES=openid profile email
# SERVICENOW_API_KEY_HEADER=x-sn-apikey
# SESSION_TTL_SECONDS=86400
# SESSION_ABSOLUTE_LIFETIME_SECONDS=604800
# REQUIRE_OAUTH_CONSENT=false
# ALLOW_BEARER_PASSTHROUGH=false

# Service Account Fallback (Default: false — requires per-user authentication)
ALLOW_SERVICE_ACCOUNT_FALLBACK=false
SERVICENOW_USERNAME=your-service-account-username
SERVICENOW_PASSWORD=your-service-account-password
# MCP_AUTH_TOKEN=your-shared-secret-token

# Server & Tool Options
READ_ONLY=true
MCP_TOOL_PACKAGE=full
LOG_LEVEL=INFO
SERVICENOW_TIMEOUT=30
MAX_LIMIT=100
DEFAULT_TIMEZONE=UTC
CHOICE_CACHE_TTL_SECONDS=3600